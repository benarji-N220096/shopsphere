# ==============================================================================
# ShopSphere Microservices Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting Docker Compose
# ==============================================================================

# Production Domain & SSL (Required for Production HTTPS)
DOMAIN_NAME=shopsphere.yourdomain.com
SSL_EMAIL=admin@yourdomain.com
CERTBOT_STAGING=0

# Master Database Configuration (Admin Root)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_root_password_here
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password_here

# Microservice Least-Privilege Database Accounts
AUTH_DB_USER=auth_user
AUTH_DB_PASS=auth_pass_shopsphere
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASS=product_pass_shopsphere
CART_DB_USER=cart_user
CART_DB_PASS=cart_pass_shopsphere
ORDER_DB_USER=order_user
ORDER_DB_PASS=order_pass_shopsphere
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASS=inventory_pass_shopsphere
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASS=payment_pass_shopsphere

# Security & JWT Authentication (HS384 384-bit cryptographic key)
JWT_SECRET=8f2a1b9c8e4d3f2a1b9c8e4d3f2a1b9c8e4d3f2a1b9c8e4d3f2a1b9c8e4d3f2a
INTERNAL_SERVICE_SECRET=shopsphere-internal-service-secret-key-384

# OAuth 2.0 Credentials (Optional - Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Service Discovery & Config Management
CONFIG_SERVER_URL=http://config-server:8888
EUREKA_SERVER_URL=http://service-registry:8761/eureka/
CONFIG_REPO_PATH=file:/app/config-repository/

# Observability & Admin Credentials
MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# Local Development Published Ports (Used by docker-compose.yml)
FRONTEND_PORT=5173
GATEWAY_PORT=8080
CONFIG_SERVER_PORT=8888
EUREKA_PORT=8761
MYSQL_PORT=3306
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ZIPKIN_PORT=9411
