# ShopSphere Terraform Configuration Variables Template
# Copy this file to terraform.tfvars and fill in your values

aws_region     = "ap-south-1"
environment    = "production"
instance_type  = "t3.xlarge"
disk_size_gb   = 60
key_name       = "shopsphere-prod-key"
admin_ssh_cidr = "203.0.113.50/32" # Replace with your public IP address
domain_name    = "shopsphere.yourdomain.com"
